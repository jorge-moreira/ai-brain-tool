{
  "name": "@ai-brain/core",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./graphify": "./src/graphify.ts",
    "./platforms": "./src/platforms/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "vitest run tests/unit tests/integration tests/e2e",
    "test:coverage": "vitest run --coverage tests/unit tests/integration tests/e2e",
    "test:unit": "vitest run tests/unit",
    "test:unit:ci": "bun run test:unit --coverage --coverage.reportsDirectory=coverage/unit --outputFile=coverage/unit/junit.xml",
    "test:integration": "vitest run tests/integration",
    "test:integration:ci": "bun run test:integration --coverage --coverage.reportsDirectory=coverage/integration --outputFile=coverage/integration/junit.xml"
  },
  "dependencies": {
    "execa": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "chalk": "^5.0.0",
    "ora": "^9.4.0"
  }
}
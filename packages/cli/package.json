{
  "name": "@jorge-moreira.dev/ai-brain-tool",
  "version": "2.1.0",
  "description": "Your personal AI memory, connected to all your AI tools",
  "type": "module",
  "bin": {
    "ai-brain": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outfile ./dist/index.js --target bun",
    "start": "bun run src/index.ts",
    "test": "vitest run tests/unit tests/integration tests/e2e",
    "test:coverage": "bun run test --coverage",
    "test:unit": "vitest run tests/unit",
    "test:unit:ci": "bun run test:unit -F unit --coverage --coverage.reportsDirectory=coverage/unit --outputFile=coverage/unit/junit.xml",
    "test:integration": "vitest run tests/integration",
    "test:integration:ci": "bun run test:integration -F integration-tests --coverage --coverage.reportsDirectory=coverage/integration --outputFile.junit=coverage/integration/junit.xml",
    "test:e2e": "vitest run tests/e2e",
    "test:e2e:ci": "bun run test:e2e -F e2e --coverage --coverage.reportsDirectory=coverage/e2e --outputFile=coverage/e2e/junit.xml",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --project tests/e2e/tsconfig.json --noEmit"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ai-brain/core": "*",
    "@inquirer/prompts": "^8.4.2",
    "chalk": "^5.0.0",
    "commander": "^14.0.3",
    "execa": "^9.0.0",
    "inquirer": "^13.4.2",
    "ora": "^9.4.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@amiceli/vitest-cucumber": "^6.3.0"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=2.0"
  }
}
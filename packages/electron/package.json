{
  "name": "@ai-brain/electron",
  "version": "2.1.0",
  "private": true,
  "description": "AI Brain Desktop Application",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:dir": "vite build && electron-builder --dir",
    "preview": "vite preview",
    "electron:dev": "concurrently \"bun run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "test": "vitest run tests/unit tests/integration tests/e2e",
    "test:coverage": "bun run test --coverage",
    "test:unit": "vitest run tests/unit",
    "test:unit:ci": "bun run test:unit -F unit --coverage --coverage.reportsDirectory=coverage/unit --outputFile=coverage/unit/junit.xml",
    "test:integration": "vitest run tests/integration",
    "test:integration:ci": "bun run test:integration -F integration-tests --coverage --coverage.reportsDirectory=coverage/integration --outputFile.junit=coverage/integration/junit.xml",
    "test:e2e": "vitest run tests/e2e",
    "test:e2e:ci": "bun run test:e2e -F e2e --coverage --coverage.reportsDirectory=coverage/e2e --outputFile=coverage/e2e/junit.xml",
  },
  "dependencies": {
    "@ai-brain/core": "workspace:*",
    "@ai-brain/ui": "workspace:*",
    "electron-updater": "^6.0.0"
  },
  "devDependencies": {
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "wait-on": "^7.0.0"
  }
}
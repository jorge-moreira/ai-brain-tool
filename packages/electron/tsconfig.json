{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@ai-brain/ui": ["../ui/src"],
      "@ai-brain/ui/*": ["../ui/src/*"],
      "@ai-brain/core": ["../core/src"],
      "@ai-brain/core/*": ["../core/src/*"]
    }
  },
  "include": ["src/**/*"]
}

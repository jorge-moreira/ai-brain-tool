{
  "name": "ai-brain-tool-monorepo",
  "version": "2.1.4",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "typescript": "^6.0.3",
      "react": "^19.2.5",
      "react-dom": "^19.2.5",
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3",
      "@types/node": "^25.6.0",
      "vitest": "^4.1.5",
      "@vitest/coverage-v8": "^4.1.5",
      "eslint": "^10.3.0",
      "@tailwindcss/vite": "^4.1.6",
      "@typescript-eslint/eslint-plugin": "^8.59.1",
      "@typescript-eslint/parser": "^8.59.1"
    }
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "app:build": "bun run --filter @ai-brain/app build",
    "app:build:stable": "bun run --filter @ai-brain/app build:stable",
    "app:dev": "bun run --filter @ai-brain/app dev:hmr",
    "cli:start": "bun run --filter @jorge-moreira.dev/ai-brain-tool start",
    "test": "bun run --filter \"*\" test",
    "test:core": "bun run --filter @ai-brain/core test",
    "test:core:unit:ci": "bun run --filter @ai-brain/core test:unit:ci",
    "test:core:integration:ci": "bun run --filter @ai-brain/core test:integration:ci",
    "test:cli": "bun run --filter @jorge-moreira.dev/ai-brain-tool test",
    "test:cli:unit:ci": "bun run --filter @jorge-moreira.dev/ai-brain-tool test:unit:ci",
    "test:cli:integration:ci": "bun run --filter @jorge-moreira.dev/ai-brain-tool test:integration:ci",
    "test:cli:e2e": "bun run --filter @jorge-moreira.dev/ai-brain-tool test:e2e:local"
  },
  "license": "MIT",
  "dependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "semantic-release": "^25.0.3",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.1",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:"
  }
}
